{
  "@@locale": "de",
  "appTitle": "Yumdoor",
  "@appTitle": {
    "description": "Product name, shown as the browser tab title and on the start screen."
  },
  "loginTagline": "Verbinde dich mit deinem Tandoor-Server.",
  "@loginTagline": {
    "description": "Subtitle under the app name on the login screen."
  },
  "loginServerLabel": "Server-Adresse",
  "@loginServerLabel": {
    "description": "Label of the server URL field on the login screen."
  },
  "loginServerRequired": "Gib die Adresse deines Tandoor-Servers ein.",
  "@loginServerRequired": {
    "description": "Validation message when the server URL field is empty."
  },
  "loginServerInvalid": "Das ist keine gültige Adresse.",
  "@loginServerInvalid": {
    "description": "Shown under the server URL field when the text can't be a URL."
  },
  "loginServerChecking": "Server wird geprüft …",
  "@loginServerChecking": {
    "description": "Shown under the server URL field while the version check runs."
  },
  "loginServerFound": "Tandoor {version} gefunden",
  "@loginServerFound": {
    "description": "Shown under the server URL field when a supported Tandoor answered.",
    "placeholders": {
      "version": {
        "type": "String",
        "example": "2.6.15"
      }
    }
  },
  "loginServerUnsupported": "Tandoor {version} wird nicht unterstützt. Yumdoor braucht Tandoor 2.x.",
  "@loginServerUnsupported": {
    "description": "Shown when the server runs a Tandoor version other than 2.x.",
    "placeholders": {
      "version": {
        "type": "String",
        "example": "1.5.24"
      }
    }
  },
  "loginServerNotTandoor": "Unter dieser Adresse läuft kein Tandoor 2.x.",
  "@loginServerNotTandoor": {
    "description": "Shown when something answered at the URL, but not Tandoor."
  },
  "loginServerUnreachable": "Der Server ist nicht erreichbar. Prüf die Adresse und deine Verbindung.",
  "@loginServerUnreachable": {
    "description": "Shown when the server URL can't be reached, or login fails for lack of a connection."
  },
  "loginServerError": "Der Server hat einen Fehler gemeldet. Versuch es später noch einmal.",
  "@loginServerError": {
    "description": "Shown when the server answers the version check or login with an unexpected error."
  },
