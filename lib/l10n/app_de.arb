    "description": "Shown in the web build when the entered server is on a different origin than the app.",
    "placeholders": {
      "origin": {
        "type": "String",
        "example": "https://rezepte.example.de"
      }
    }
  },
  "loginMethodLabel": "Anmeldeart",
