# Defaults for the local dev Tandoor (docker/tandoor/compose.yml). Dev only:
# these values are public. To change something locally, copy this file to
# .env (git-ignored) and edit it there; .env overrides these values.

SECRET_KEY=yumdoor-dev-only-not-a-secret-0123456789abcdefghijklmnopqrstuvwxyz
ALLOWED_HOSTS=*
DEBUG=0
TZ=Europe/Berlin

DB_ENGINE=django.db.backends.postgresql
POSTGRES_HOST=db_recipes
POSTGRES_PORT=5432
POSTGRES_DB=tandoor
POSTGRES_USER=tandoor
POSTGRES_PASSWORD=tandoor-dev-only
