# Normalize line endings: LF in the repo and on every checkout (dart format expects LF).
* text=auto eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

*.png  binary
*.jpg  binary
*.webp binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.wasm binary

# Generated code: collapse in GitHub diffs
packages/tandoor_api/lib/** linguist-generated=true
packages/tandoor_api/schema/** linguist-generated=true
**/*.g.dart        linguist-generated=true
**/*.freezed.dart  linguist-generated=true
lib/l10n/generated/** linguist-generated=true

# Vendored from the drift release that matches pubspec.lock (docs/ARCHITECTURE.md#offline-cache).
web/drift_worker.js linguist-vendored=true -diff
